{
  "name": "postack-underflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/finalize-404.mjs",
    "preview": "node scripts/serve-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "validate": "node scripts/validate-build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate",
    "smoke": "node scripts/smoke-deployed.mjs",
    "corpus:fetch": "node scripts/corpus-fetch.mjs",
    "index": "node scripts/build-index.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "browser": "node scripts/browser-check.mjs && node scripts/lab-check.mjs && node scripts/lab-specimens.mjs",
    "browser:lab": "node scripts/lab-check.mjs",
    "index:check": "node scripts/check-index.mjs",
    "commons:snapshot": "node scripts/commons/snapshot.mjs",
    "commons:check": "node scripts/commons/check-corpus.mjs",
    "commons:records": "node scripts/commons/check-records.mjs",
    "commons:index": "node scripts/commons/build-index.mjs",
    "commons:index:check": "node scripts/commons/build-index.mjs --check",
    "commons:brainstorm": "node scripts/commons/brainstorm.mjs",
    "commons:brainstorm:check": "node scripts/commons/brainstorm.mjs --check",
    "commons:atproto": "node scripts/commons/atproto-snapshot.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
